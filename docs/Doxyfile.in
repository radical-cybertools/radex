PROJECT_NAME           = "RaDex"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
RECURSIVE              = YES
EXTRACT_ALL            = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
INPUT                  = "@CMAKE_SOURCE_DIR@/include/raddex"
FILE_PATTERNS          = *.h *.hpp *.c *.cc *.cpp
